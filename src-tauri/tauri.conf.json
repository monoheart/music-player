{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "music-player",
  "version": "0.1.0",
  "identifier": "com.musicplayer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "音乐播放器",
        "width": 1200,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 720,
        "decorations": false,
        "additionalBrowserArgs": "--disk-cache-size=67108864"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/covers/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
